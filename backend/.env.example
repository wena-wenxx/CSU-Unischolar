APP_NAME="CSU UniScholar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (the project's real database). Create the database first:
#   CREATE DATABASE csu_unischolar CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Quick test without MySQL: set DB_CONNECTION=sqlite and comment out the DB_* lines.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=csu_unischolar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = background jobs (e-mails) run immediately; no extra terminal needed.
# For real SMTP you may use "database" and run: php artisan queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail. Demo accounts are FICTIONAL, so never deliver to real inboxes.
# Option 1 (no setup): MAIL_MAILER=log -> e-mails are written into
#   storage/logs/laravel.log
# Option 2 (see real e-mails safely): a free Mailtrap "Email Testing" inbox
#   catches every message; nothing reaches the real address. Copy the SMTP
#   values from Mailtrap -> Email Testing -> Inboxes -> SMTP settings:
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<from Mailtrap>
#   MAIL_PASSWORD=<from Mailtrap>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="scholarguide@example.com"
MAIL_FROM_NAME="ScholarGuide (CSU OAS demo)"
# Safety net: send EVERY e-mail to this one address instead (leave empty to disable).
MAIL_ALWAYS_TO=
# Link inside e-mails
APP_FRONTEND_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CSU UniScholar AI service (run: uvicorn main:app --port 8001 inside ai-service/)
AI_SERVICE_URL=http://127.0.0.1:8001

# Frontend address(es) allowed to call the API (comma-separated). Leave unset locally.
# FRONTEND_URL=https://your-frontend.vercel.app
